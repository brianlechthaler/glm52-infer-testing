# GLM 5.2 vLLM deployment - tuned for 8x RTX PRO 6000 Blackwell (96 GB each)
# Copy to .env and adjust as needed.
# Switch to zai-org/GLM-5.2-FP8 if you prefer the official FP8 checkpoint (~750 GB weights).
MODEL=nvidia/GLM-5.2-NVFP4
SERVED_MODEL_NAME=glm-5.2

# Use every GPU on the node.
TENSOR_PARALLEL_SIZE=8
NVIDIA_VISIBLE_DEVICES=all

# Maximize VRAM for weights + KV cache. Raise only after smoke-testing concurrency.
GPU_MEMORY_UTILIZATION=0.95

# FP8 KV cache is required for long context on Blackwell.
KV_CACHE_DTYPE=fp8_e4m3

# Concurrency / context knobs. Lower MAX_NUM_SEQS if you OOM under load.
MAX_NUM_SEQS=32
MAX_MODEL_LEN=262144

# MTP speculative decoding (GLM 5.2 throughput boost).
MTP_SPECULATIVE_TOKENS=5

# Hugging Face cache on host. Model is ~465 GB for NVFP4, ~750 GB for FP8.
HF_HOME=${HOME}/.cache/huggingface

# Optional: set in .env if you use a gated checkpoint or need higher Hub rate limits.
# HF_TOKEN=

# API port exposed on host.
VLLM_PORT=8000

# Frontend chat UI port exposed on host.
FRONTEND_PORT=5173

# vLLM image. Use `latest` on RTX PRO 6000 Blackwell (SM12.0); the glm52 tag
# lacks FLASHINFER_MLA_SPARSE_SM120 and fails with fp8 KV cache on SM12.0.
# On Hopper/datacenter Blackwell (SM10.x), glm52 or latest both work.
VLLM_IMAGE=vllm/vllm-openai:latest

# Required on SM12.0 for GLM 5.2 sparse MLA. Omit on Hopper/SM10.x to use defaults.
ATTENTION_BACKEND=FLASHINFER_MLA_SPARSE_SM120
