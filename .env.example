# GLM 5.2 vLLM deployment - tuned for 8x RTX PRO 6000 Blackwell (96 GB each)
# Copy to .env and adjust as needed.
MODEL=nvidia/GLM-5.2-NVFP4
SERVED_MODEL_NAME=glm-5.2

TENSOR_PARALLEL_SIZE=8
DECODE_CONTEXT_PARALLEL_SIZE=1
NVIDIA_VISIBLE_DEVICES=all

GPU_MEMORY_UTILIZATION=0.95

# fp8 KV cache (fp8_ds_mla packed layout) is required on SM120.
KV_CACHE_DTYPE=fp8

MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
MAX_MODEL_LEN=1048576

# MTP speculative decoding. Set to 0 until B12X supports unquantized MTP draft MoE.
MTP_SPECULATIVE_TOKENS=0

# Coherence-critical for GLM-5.2 DSA indexer layers (78 chars: F=full, S=shared).
INDEX_TOPK_PATTERN=FFFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSS

HF_HOME=${HOME}/.cache/huggingface
# HF_TOKEN=

VLLM_PORT=8000
FRONTEND_PORT=5173

# SM120-native vLLM image with B12X sparse MLA + NVFP4 MoE support.
# Pull once: docker pull voipmonitor/vllm:eldritch-enlightenment-v3f65c52-b12x80eb49b-fi5a73a36-cu132-20260703
VLLM_IMAGE=voipmonitor/vllm:eldritch-enlightenment-v3f65c52-b12x80eb49b-fi5a73a36-cu132-20260703
ATTENTION_BACKEND=B12X_MLA_SPARSE

# Optional: stock vLLM + runtime SM120 patches (experimental; sparse MLA incomplete).
# docker compose --profile stock-patches up -d glm52-vllm-stock frontend
# VLLM_STOCK_IMAGE=vllm/vllm-openai:latest
